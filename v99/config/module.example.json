{
  "module_id": "aurelia-prisma",
  "name": "Aurelia Prisma",
  "version": "1.0.0",
  "api_version": "1",
  "enabled": true,
  "platforms": ["windows", "linux", "macos"],
  "capabilities": ["health_check", "audit", "recovery"],
